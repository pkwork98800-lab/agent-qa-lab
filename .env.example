# ---------------------------------------------------------------------------
# agent-qa-lab — environment template
# ---------------------------------------------------------------------------
# Copy to .env (which is git-ignored) and edit. Nothing here is required:
# offline mode — the default — needs no keys and no external services, and the
# whole harness runs deterministically at $0.00. Live mode is opt-in
# (EVAL_MODE=live) and validates only what it needs at startup (src/lib/env.ts).
# Every secret value below is empty on purpose: no real keys ever belong here.

# EVAL_MODE — `offline` (default) replays recorded fixtures and meters $0.00;
# `live` calls real LLM APIs and is metered against MAX_RUN_COST_USD.
EVAL_MODE=

# MAX_RUN_COST_USD — live-mode cost ceiling per run, in USD. Offline runs never
# meter real spend. Optional; the default is 2.
MAX_RUN_COST_USD=

# APP_PORT — port the app under test (apps/under-test) listens on for the eval
# runner. Optional; the default is 4799.
APP_PORT=

# PLAYWRIGHT_APP_PORT — port the app listens on for Playwright runs. Optional;
# the default is 4731.
PLAYWRIGHT_APP_PORT=

# APP_BASE_URL — base URL the verifier and eval runner use to reach the app.
# Read by the app and the runner; empty falls back to http://127.0.0.1:4799
# (APP_PORT resolved to a loopback address).
APP_BASE_URL=

# APP_DB_PATH — SQLite file the app opens. Read by the app; empty means an
# in-memory DB, which is the deterministic default: every start re-seeds from
# the frozen seed contract.
APP_DB_PATH=

# RUN_ID — optional override of the deterministic run id
# (`offline-<10 hex chars of sha256(sorted scenario ids + code version)>`).
# Leave empty to let the runner compute it. Optional.
RUN_ID=

# --- Live-mode credentials (all optional; required only with EVAL_MODE=live) ---

# ANTHROPIC_API_KEY — Anthropic API key for the `claude` judge/agent provider.
ANTHROPIC_API_KEY=

# OPENAI_API_KEY — OpenAI API key for the `openai` judge/agent provider.
OPENAI_API_KEY=

# LINEAR_API_KEY — Linear API key used by the triage module to file tickets.
LINEAR_API_KEY=

# LINEAR_TEAM_ID — Linear team id tickets are filed against.
LINEAR_TEAM_ID=

# LANGFUSE_PUBLIC_KEY — Langfuse public key for live trace export.
LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY — Langfuse secret key for live trace export.
LANGFUSE_SECRET_KEY=

# LANGFUSE_HOST — Langfuse base URL, e.g. the hosted cloud or a self-managed
# instance. Optional; the default is https://cloud.langfuse.com.
LANGFUSE_HOST=
